generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  WORKER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum BookingMode {
  INSTANT
  SCHEDULED
}

enum BookingStatus {
  REQUESTED
  MATCHING
  ASSIGNED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  PAYMENT_PENDING
  PAID
  CANCELLED
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  role         Role
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  customer     CustomerProfile?
  worker       WorkerProfile?
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String?
  phone     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses Address[]
  bookings  Booking[]
}

model WorkerProfile {
  id             String               @id @default(uuid())
  userId         String               @unique
  name           String
  phone          String?
  experienceYears Int                 @default(0)
  rating         Float               @default(0)
  verified       Boolean              @default(false)
  serviceAreaKm  Float                @default(10)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         WorkerSkill[]
  availability   WorkerAvailability[]
  locations      WorkerLocation[]
  bookings       Booking[]
  verifications  WorkerVerification[]
  performance    WorkerPerformance?
}

model Service {
  id       String        @id @default(uuid())
  name     String        @unique
  slug     String        @unique
  active   Boolean       @default(true)

  skills   WorkerSkill[]
  bookings Job[]
}

model WorkerSkill {
  id       String         @id @default(uuid())
  workerId String
  serviceId String

  worker   WorkerProfile  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  service  Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([workerId, serviceId])
}

model WorkerVerification {
  id          String             @id @default(uuid())
  workerId    String
  type        String
  documentUrl String
  status      VerificationStatus @default(PENDING)
  reviewedAt  DateTime?

  worker      WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model WorkerAvailability {
  id         String        @id @default(uuid())
  workerId   String
  dayOfWeek  Int
  startMinute Int
  endMinute   Int

  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, dayOfWeek])
}

model WorkerLocation {
  id         String        @id @default(uuid())
  workerId   String
  latitude   Float
  longitude  Float
  recordedAt DateTime      @default(now())

  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, recordedAt])
}

model Address {
  id         String          @id @default(uuid())
  customerId String
  label      String
  line1      String
  city       String
  latitude   Float
  longitude  Float

  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

model Job {
  id                   String    @id @default(uuid())
  serviceId            String
  description          String
  complexity           Int       @default(1)
  estimatedDurationMin Int?
  actualDurationMin    Int?
  createdAt            DateTime  @default(now())

  service              Service   @relation(fields: [serviceId], references: [id])
  booking              Booking?
}

model Booking {
  id                  String          @id @default(uuid())
  customerId          String
  jobId               String          @unique
  workerId            String?
  addressId           String?
  mode                BookingMode
  scheduledAt         DateTime?
  status              BookingStatus   @default(REQUESTED)
  predictedEtaMin     Float?
  predictedDurationMin Float?
  rankingScore        Float?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  customer            CustomerProfile @relation(fields: [customerId], references: [id])
  job                 Job              @relation(fields: [jobId], references: [id])
  worker              WorkerProfile?   @relation(fields: [workerId], references: [id])
  address             Address?         @relation(fields: [addressId], references: [id])

  statusHistory       BookingStatusHistory[]
  payments            Payment[]
  reviews             Review[]
  messages            Message[]

  @@index([status, scheduledAt])
  @@index([workerId, status])
}

model BookingStatusHistory {
  id        String        @id @default(uuid())
  bookingId String
  status    BookingStatus
  createdAt DateTime      @default(now())

  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String
  amount        Float
  currency      String   @default("INR")
  transactionId String?
  status        String

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  bookingId String
  rating    Int
  comment   String?

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String   @id @default(uuid())
  bookingId   String?
  subject     String
  description String
  status      String   @default("OPEN")
}

model Message {
  id        String   @id @default(uuid())
  bookingId String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model DeviceToken {
  id       String @id @default(uuid())
  userId   String
  token    String @unique
  platform String
}

model WorkerSchedule {
  id        String   @id @default(uuid())
  workerId  String
  startAt   DateTime
  endAt     DateTime
  bookingId String?

  @@index([workerId, startAt, endAt])
}

model DemandRecord {
  id         String   @id @default(uuid())
  serviceId  String
  locationKey String
  timestamp  DateTime
  count      Int

  @@index([serviceId, locationKey, timestamp])
}

model PredictionRecord {
  id          String   @id @default(uuid())
  model       String
  modelVersion String
  entityId    String?
  input       Json
  output      Json
  createdAt   DateTime @default(now())

  @@index([model, createdAt])
}

model WorkerPerformance {
  id                 String        @id @default(uuid())
  workerId           String        @unique
  acceptanceRate     Float         @default(0)
  avgEtaError        Float         @default(0)
  avgDurationError   Float         @default(0)
  completionRate     Float         @default(0)
  complaintRate      Float         @default(0)

  worker             WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}